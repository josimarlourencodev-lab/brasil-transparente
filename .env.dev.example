# ============================================================
# Brasil Transparente - Ambiente Docker (dev local)
# Rode scripts/security/dev_tokens.py primeiro para gerar
# .env.local.dev (segredo JWT + chaves anon/service_role).
# ============================================================

# --- Banco de dados local (espelho do schema de produção) ---
POSTGRES_USER=brasil_transparente
POSTGRES_PASSWORD=brasil_transparente_dev
POSTGRES_DB=brasil_transparente
# Porta do Postgres no host
POSTGRES_PORT=5432

# --- PostgREST (API REST compatível com Supabase) ---
# URL base visível ao navegador (host). Utilizada pelo frontend.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# URL base interna para SSR dentro do container (serviço `api`).
SUPABASE_INTERNAL_URL=http://api:3000
POSTGRES_DB_URI=postgres://brasil_transparente:brasil_transparente_dev@db:5432/brasil_transparente
PGRST_DB_SCHEMAS=public
PGRST_DB_ANON_ROLE=anon

# --- Frontend (Next.js hot-reload) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Senha do painel de auditoria (/admin). troque em ambientes reais.
ADMIN_PASSWORD=troque-esta-senha-dev

# --- Worker / Scraping ---
INGEST_INTERVAL_MINUTOS=360
# Quando vazio, o LLM é ignorado (faz apenas coleta + sanitização).
LLM_PROVIDER=groq
LLM_API_KEY=