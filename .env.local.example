# ============================================
# Brasil Transparente - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha
# ============================================

# --- Supabase ---
# URL do projeto (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url.supabase.co
# Chave pública anônima (frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Chave service_role (somente backend/scripts - NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM (provider gratuito) ---
# Opções: groq | together | gemini
LLM_PROVIDER=groq
LLM_API_KEY=your-llm-api-key

# --- Painel Admin ---
# Senha para acesso ao painel de auditoria
ADMIN_PASSWORD=change-me-strong-password

# --- Fontes RSS (separadas por vírgula) ---
RSS_FEEDS_OFICIAIS=
RSS_FEEDS_IMPRENSA=
RSS_FEEDS_INDEPENDENTES=